# Copy to .env and export values (Docker Compose reads .env automatically).
MCPSHIELD_LLM_MODEL=
MCPSHIELD_LLM_API_KEY=
MCPSHIELD_LLM_BASE_URL=https://api.openai.com/v1
MCPSHIELD_LLM_TIMEOUT=20
MCPSHIELD_API_TOKEN=
MCPSHIELD_METHOD=rules
# Add deployment hostname explicitly if hosting beyond loopback.
MCPSHIELD_ALLOWED_HOSTS=localhost,127.0.0.1
